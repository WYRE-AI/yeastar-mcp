# Each Yeastar P-Series PBX is its own appliance with its own domain/IP -
# there is no shared hosted API endpoint. PBX_DOMAIN includes scheme and
# port, e.g. https://pbx.example.com:8088 (default OpenAPI port is 8088).
# These are for stdio and for HTTP only when AUTH_MODE=env. The gateway
# Compose service does not load them. Do not add them to that service's
# environment or via env_file. Gateway mode requires X-Yeastar-Pbx-Domain,
# X-Yeastar-Client-Id, and X-Yeastar-Client-Secret on each request.
YEASTAR_PBX_DOMAIN=

# OAuth-style Client ID / Client Secret, generated per-appliance in the PBX
# web portal under Integrations -> API (toggle "API" on first). This
# connector exchanges them for a short-lived access token itself - it never
# proxies them directly to a request. See README's Authentication section.
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=

# Transport: stdio (default) or http
# MCP_TRANSPORT=stdio
# MCP_HTTP_PORT=8080
# Bind address. With a real CONDUIT_S2S_SECRET, an unset MCP_HTTP_HOST stays
# 0.0.0.0 so container deploys keep the historical bind. The image and Compose
# set 0.0.0.0 inside the container and publish the host port on 127.0.0.1.
# MCP_ALLOW_INSECURE_DEV=1 binds 127.0.0.1 only. A non-loopback value
# refuses to start.
# MCP_HTTP_HOST=127.0.0.1

# Required to start the HTTP transport. Leave this empty here. The process
# logs an error and exits non-zero when this is empty or a known placeholder
# (changeme, secret, replace-me, and the other example values). Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1. A non-loopback MCP_HTTP_HOST refuses to start.
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Yeastar-* headers; no env fallback). The container image and Compose
# service set gateway. Stdio ignores this and reads YEASTAR_* from the
# environment.
# AUTH_MODE=env

# LOG_LEVEL=info
